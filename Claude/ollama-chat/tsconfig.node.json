{
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "out",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "electron.vite.config.*",
    "main/**/*",
    "preload/**/*",
    "shared/**/*"
  ]
}
